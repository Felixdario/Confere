# Copie para .env e ajuste. Nada aqui é segredo.

# Banco e fila (Compose: Postgres+pgvector na 5434, Redis na 6381)
DATABASE_URL=postgresql+asyncpg://curriculo:curriculo@localhost:5434/curriculo
REDIS_URL=redis://localhost:6381/0

# IA. Sem chave, a API usa o provedor falso (respostas gravadas, modo demo).
ANTHROPIC_API_KEY=
CLAUDE_MODELO_EXTRACAO=claude-haiku-5-5
CLAUDE_MODELO_FEEDBACK=claude-opus-5-5
CLAUDE_ESFORCO_EXTRACAO=low
CLAUDE_ESFORCO_FEEDBACK=medium
# Robustez e custo do provedor real (ADR 0001). Tempos em segundos.
CLAUDE_MAX_TOKENS_EXTRACAO=8000
CLAUDE_MAX_TOKENS_FEEDBACK=8000
CLAUDE_TIMEOUT_EXTRACAO_S=20
CLAUDE_TIMEOUT_FEEDBACK_PRIMEIRO_EVENTO_S=40
CLAUDE_TIMEOUT_FEEDBACK_OCIOSO_S=40
CLAUDE_MAX_RETRIES=2
CLAUDE_FALLBACK_FEEDBACK=true
CLAUDE_ESTIMAR_COM_COUNT_TOKENS=true
# Interrompe a análise antes de uma chamada cujo pior caso passaria deste valor.
TETO_CUSTO_ANALISE_USD=0.60

# Limiares de similaridade da correspondência (ADR 0002/0003)
TAU_ALTO=0.85
TAU_BAIXO=0.70

# Privacidade e custo
RETENCAO_DIAS=30
TETO_CUSTO_DIARIO_USD=5

# Uploads (relativo à raiz do repositório quando a API roda de lá)
PASTA_ARQUIVOS=data/arquivos

# Web
NEXT_PUBLIC_API_URL=http://localhost:8010
