# Copie para .env e ajuste. Nada aqui é segredo.

# dev | teste | producao. Fora de dev/teste o cookie de sessão sai com Secure (ADR 0007).
AMBIENTE=dev

# Banco e fila (Compose: Postgres+pgvector na 5434, Redis na 6381)
DATABASE_URL=postgresql+asyncpg://curriculo:curriculo@localhost:5434/curriculo
REDIS_URL=redis://localhost:6381/0
# Prefixo de toda chave da aplicação no Redis (fila, eventos do SSE, limites).
REDIS_PREFIXO=curriculo
# Intervalo (s) entre as consultas do worker à fila. Maior gasta menos comandos num Redis pago por uso.
WORKER_INTERVALO_S=0.5

# Provedor da análise (ADR 0006): regras (padrão: modo demonstração, sem IA e sem custo) |
# falso (só os textos gravados das evals; testes e seed) | anthropic (exige a chave; este
# portfólio não usa, D-46).
PROVEDOR_IA=regras
PASTA_GRAVACOES=evals/gravacoes

# IA real (só com PROVEDOR_IA=anthropic).
ANTHROPIC_API_KEY=
CLAUDE_MODELO_EXTRACAO=claude-haiku-5-5
CLAUDE_MODELO_FEEDBACK=claude-opus-5-5
CLAUDE_ESFORCO_EXTRACAO=low
CLAUDE_ESFORCO_FEEDBACK=medium
# Robustez e custo do provedor real (ADR 0001). Tempos em segundos.
CLAUDE_MAX_TOKENS_EXTRACAO=8000
CLAUDE_MAX_TOKENS_FEEDBACK=8000
CLAUDE_TIMEOUT_EXTRACAO_S=20
CLAUDE_TIMEOUT_FEEDBACK_PRIMEIRO_EVENTO_S=40
CLAUDE_TIMEOUT_FEEDBACK_OCIOSO_S=40
CLAUDE_MAX_RETRIES=2
CLAUDE_FALLBACK_FEEDBACK=true
CLAUDE_ESTIMAR_COM_COUNT_TOKENS=true
# Interrompe a análise antes de uma chamada cujo pior caso passaria deste valor.
TETO_CUSTO_ANALISE_USD=0.60

# Limiares de similaridade da correspondência (ADR 0002/0003)
TAU_ALTO=0.85
TAU_BAIXO=0.70

# Privacidade e custo (ADR 0004)
RETENCAO_DIAS=30
TETO_CUSTO_DIARIO_USD=5
VERSAO_CONSENTIMENTO=2026-11-16

# Sessão e abuso (ADR 0004 e 0007). Login: tentativas a cada 15 min; análises: por hora.
SESSAO_DIAS=7
LIMITE_LOGIN_POR_EMAIL=5
LIMITE_LOGIN_POR_IP=30
LIMITE_CADASTRO_POR_IP=10
LIMITE_ANALISES_POR_USUARIO=30
LIMITE_ANALISES_POR_IP=60
MAX_CANDIDATOS_POR_PROCESSO=20
CORS_ORIGENS=["http://localhost:3010"]

# CSRF ligado à sessão (HMAC). Vazio: cada processo sorteia uma chave (defina com mais de um processo).
# CHAVE_CSRF=uma-chave-longa-e-aleatoria

# SSE e fila (segundos). Conexões SSE simultâneas por pessoa e por IP; teto do pool Redis da API.
LIMITE_SSE_POR_USUARIO=5
LIMITE_SSE_POR_IP=10
REDIS_MAX_CONEXOES=50
# Vazio: TEMPO_MAX_ANALISE_S + 120.
# SSE_DURACAO_MAX_S=420
SSE_HEARTBEAT_S=15
EVENTOS_TTL_S=86400
TEMPO_MAX_ANALISE_S=300

# Uploads (relativo à raiz do repositório quando a API roda de lá)
PASTA_ARQUIVOS=data/arquivos
# Modelo de embeddings: make modelos baixa uma vez para cá (o worker nunca baixa no meio de uma análise).
PASTA_MODELOS=data/modelos
INGESTAO_TAMANHO_MAX_BYTES=5242880

# Web
NEXT_PUBLIC_API_URL=http://localhost:8010
